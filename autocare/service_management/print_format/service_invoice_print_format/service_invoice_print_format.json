 "html": "<div style=\"padding: 25px; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #333;\">\r\n\r\n    <!-- Company Header Section -->\r\n    <table style=\"width: 100%; border-bottom: 2px solid #2563eb; padding-bottom: 15px; margin-bottom: 20px;\">\r\n        <tr>\r\n            <td style=\"vertical-align: middle;\">\r\n                <h1 style=\"margin: 0; color: #2563eb; font-size: 28px; font-weight: 800; letter-spacing: 1px;\">AUTO CARE ERP</h1>\r\n                <p style=\"margin: 4px 0 0 0; color: #666; font-size: 13px;\">Automobile Service & Maintenance Solutions</p>\r\n            </td>\r\n            <td style=\"text-align: right; vertical-align: middle;\">\r\n                <h2 style=\"margin: 0; color: #1e293b; font-size: 20px; text-transform: uppercase;\">SERVICE INVOICE</h2>\r\n                <p style=\"margin: 4px 0 0 0; font-size: 14px; font-weight: bold; color: #2563eb;\"># {{ doc.name }}</p>\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- Invoice & Customer Info Grid -->\r\n    <table style=\"width: 100%; margin-bottom: 25px; border-collapse: collapse;\">\r\n        <tr>\r\n            <td style=\"width: 50%; vertical-align: top; padding-right: 15px;\">\r\n                <div style=\"background: #f8fafc; padding: 12px 15px; border-radius: 8px; border: 1px solid #e2e8f0;\">\r\n                    <p style=\"margin: 0 0 6px 0; font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: bold;\">Billed To</p>\r\n                    <h4 style=\"margin: 0; color: #0f172a; font-size: 16px;\">{{ doc.customer }}</h4>\r\n                    <p style=\"margin: 6px 0 0 0; font-size: 13px; color: #475569;\"><strong>Job Card Ref:</strong> {{ doc.job_card }}</p>\r\n                </div>\r\n            </td>\r\n            <td style=\"width: 50%; vertical-align: top; padding-left: 15px;\">\r\n                <div style=\"background: #f8fafc; padding: 12px 15px; border-radius: 8px; border: 1px solid #e2e8f0;\">\r\n                    <p style=\"margin: 0 0 6px 0; font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: bold;\">Invoice Details</p>\r\n                    <p style=\"margin: 0 0 4px 0; font-size: 13px;\"><strong>Invoice Date:</strong> {{ frappe.utils.formatdate(doc.invoice_date) if doc.invoice_date else '' }}</p>\r\n                    <p style=\"margin: 0; font-size: 13px;\">\r\n                        <strong>Payment Status:</strong> \r\n                        {% if doc.payment_status == 'Paid' %}\r\n                            <span style=\"background: #dcfce7; color: #166534; padding: 2px 8px; border-radius: 4px; font-weight: bold; font-size: 12px;\">Paid</span>\r\n                        {% elif doc.payment_status == 'Partially Paid' %}\r\n                            <span style=\"background: #fef9c3; color: #854d0e; padding: 2px 8px; border-radius: 4px; font-weight: bold; font-size: 12px;\">Partially Paid</span>\r\n                        {% else %}\r\n                            <span style=\"background: #fee2e2; color: #991b1b; padding: 2px 8px; border-radius: 4px; font-weight: bold; font-size: 12px;\">Unpaid</span>\r\n                        {% endif %}\r\n                    </p>\r\n                </div>\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- Breakdown Table -->\r\n    <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 25px;\">\r\n        <thead>\r\n            <tr style=\"background-color: #2563eb; color: #ffffff; text-align: left;\">\r\n                <th style=\"padding: 10px 12px; font-size: 13px; border-top-left-radius: 6px;\">#</th>\r\n                <th style=\"padding: 10px 12px; font-size: 13px;\">Description / Service Breakdown</th>\r\n                <th style=\"padding: 10px 12px; font-size: 13px; text-align: right; border-top-right-radius: 6px;\">Amount</th>\r\n            </tr>\r\n        </thead>\r\n        <tbody>\r\n            <tr style=\"border-bottom: 1px solid #e2e8f0;\">\r\n                <td style=\"padding: 12px; font-size: 13px; color: #64748b;\">1</td>\r\n                <td style=\"padding: 12px; font-size: 13px; font-weight: 500;\">Labour / Service Charges</td>\r\n                <td style=\"padding: 12px; font-size: 13px; text-align: right;\">{{ doc.get_formatted(\"labour_cost\") }}</td>\r\n            </tr>\r\n            <tr style=\"border-bottom: 1px solid #e2e8f0; background-color: #f8fafc;\">\r\n                <td style=\"padding: 12px; font-size: 13px; color: #64748b;\">2</td>\r\n                <td style=\"padding: 12px; font-size: 13px; font-weight: 500;\">Spare Parts & Materials Cost</td>\r\n                <td style=\"padding: 12px; font-size: 13px; text-align: right;\">{{ doc.get_formatted(\"parts_cost\") }}</td>\r\n            </tr>\r\n        </tbody>\r\n    </table>\r\n\r\n    <!-- Totals Summary Table -->\r\n    <table style=\"width: 100%; margin-bottom: 30px;\">\r\n        <tr>\r\n            <td style=\"width: 50%;\"></td>\r\n            <td style=\"width: 50%;\">\r\n                <table style=\"width: 100%; border-collapse: collapse;\">\r\n                    <tr>\r\n                        <td style=\"padding: 6px 12px; font-size: 13px; color: #475569; font-weight: bold;\">Total Amount:</td>\r\n                        <td style=\"padding: 6px 12px; font-size: 14px; text-align: right; font-weight: bold; color: #0f172a;\">{{ doc.get_formatted(\"total_amount\") }}</td>\r\n                    </tr>\r\n                    <tr>\r\n                        <td style=\"padding: 6px 12px; font-size: 13px; color: #166534;\">Paid Amount:</td>\r\n                        <td style=\"padding: 6px 12px; font-size: 13px; text-align: right; color: #166534; font-weight: bold;\">{{ doc.get_formatted(\"paid_amount\") }}</td>\r\n                    </tr>\r\n                    <tr style=\"border-top: 2px solid #2563eb;\">\r\n                        <td style=\"padding: 8px 12px; font-size: 14px; font-weight: bold; color: #991b1b;\">Balance Due:</td>\r\n                        <td style=\"padding: 8px 12px; font-size: 15px; text-align: right; font-weight: bold; color: #991b1b;\">{{ doc.get_formatted(\"balance_amount\") }}</td>\r\n                    </tr>\r\n                </table>\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- Footer Terms & Signatures -->\r\n    <table style=\"width: 100%; margin-top: 40px; border-top: 1px solid #e2e8f0; padding-top: 20px;\">\r\n        <tr>\r\n            <td style=\"width: 60%; vertical-align: top; font-size: 12px; color: #64748b;\">\r\n                <strong>Terms & Conditions:</strong>\r\n                <ul style=\"margin: 5px 0 0 0; padding-left: 18px;\">\r\n                    <li>Goods once sold or fitted will not be taken back.</li>\r\n                    <li>Please collect your vehicle within 24 hours of servicing.</li>\r\n                </ul>\r\n            </td>\r\n            <td style=\"width: 40%; text-align: right; vertical-align: bottom;\">\r\n                <p style=\"margin: 0 0 45px 0; font-size: 13px; font-weight: bold; color: #334155;\">For Auto Care ERP</p>\r\n                <p style=\"margin: 0; font-size: 12px; border-top: 1px dashed #cbd5e1; display: inline-block; padding-top: 4px; color: #64748b;\">Authorized Signatory</p>\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n</div>",
