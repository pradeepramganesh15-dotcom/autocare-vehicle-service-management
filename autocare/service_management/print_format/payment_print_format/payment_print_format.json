 "html": "<div style=\"padding: 25px; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #333;\">\r\n\r\n    <!-- Company Header Section -->\r\n    <table style=\"width: 100%; border-bottom: 2px solid #16a34a; padding-bottom: 15px; margin-bottom: 20px;\">\r\n        <tr>\r\n            <td style=\"vertical-align: middle;\">\r\n                <h1 style=\"margin: 0; color: #16a34a; font-size: 28px; font-weight: 800; letter-spacing: 1px;\">AUTO CARE ERP</h1>\r\n                <p style=\"margin: 4px 0 0 0; color: #666; font-size: 13px;\">Automobile Service & Maintenance Solutions</p>\r\n            </td>\r\n            <td style=\"text-align: right; vertical-align: middle;\">\r\n                <h2 style=\"margin: 0; color: #1e293b; font-size: 20px; text-transform: uppercase;\">PAYMENT RECEIPT</h2>\r\n                <p style=\"margin: 4px 0 0 0; font-size: 14px; font-weight: bold; color: #16a34a;\"># {{ doc.name }}</p>\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- Receipt Details Section -->\r\n    <table style=\"width: 100%; margin-bottom: 25px; border-collapse: collapse;\">\r\n        <tr>\r\n            <td style=\"width: 50%; vertical-align: top; padding-right: 15px;\">\r\n                <div style=\"background: #f8fafc; padding: 12px 15px; border-radius: 8px; border: 1px solid #e2e8f0;\">\r\n                    <p style=\"margin: 0 0 6px 0; font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: bold;\">Received From</p>\r\n                    <h4 style=\"margin: 0; color: #0f172a; font-size: 16px;\">{{ doc.customer }}</h4>\r\n                    <p style=\"margin: 6px 0 0 0; font-size: 13px; color: #475569;\"><strong>Service Invoice Ref:</strong> {{ doc.service_invoice }}</p>\r\n                </div>\r\n            </td>\r\n            <td style=\"width: 50%; vertical-align: top; padding-left: 15px;\">\r\n                <div style=\"background: #f8fafc; padding: 12px 15px; border-radius: 8px; border: 1px solid #e2e8f0;\">\r\n                    <p style=\"margin: 0 0 6px 0; font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: bold;\">Payment Details</p>\r\n                    <p style=\"margin: 0 0 4px 0; font-size: 13px;\"><strong>Payment Date:</strong> {{ frappe.utils.formatdate(doc.payment_date) if doc.payment_date else '' }}</p>\r\n                    <p style=\"margin: 0 0 4px 0; font-size: 13px;\"><strong>Payment Mode:</strong> {{ doc.payment_mode }}</p>\r\n                    <p style=\"margin: 0; font-size: 13px;\"><strong>Ref No / Txn ID:</strong> {{ doc.reference_number or 'N/A' }}</p>\r\n                </div>\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- Amount Summary Box -->\r\n    <div style=\"background-color: #f0fdf4; border: 1px solid #bbf7d0; padding: 20px; border-radius: 8px; text-align: center; margin-bottom: 30px;\">\r\n        <span style=\"font-size: 14px; text-transform: uppercase; color: #166534; font-weight: bold; letter-spacing: 0.5px;\">Amount Received</span>\r\n        <h1 style=\"margin: 8px 0 0 0; color: #15803d; font-size: 32px; font-weight: 800;\">{{ doc.get_formatted(\"amount\") }}</h1>\r\n    </div>\r\n\r\n    <!-- Signatures & Footer -->\r\n    <table style=\"width: 100%; margin-top: 50px; border-top: 1px solid #e2e8f0; padding-top: 20px;\">\r\n        <tr>\r\n            <td style=\"width: 60%; vertical-align: top; font-size: 12px; color: #64748b;\">\r\n                <p style=\"margin: 0; font-style: italic;\">Dis na computer-generated payment receipt. Signature noh required for validation.</p>\r\n            </td>\r\n            <td style=\"width: 40%; text-align: right; vertical-align: bottom;\">\r\n                <p style=\"margin: 0 0 45px 0; font-size: 13px; font-weight: bold; color: #334155;\">For Auto Care ERP</p>\r\n                <p style=\"margin: 0; font-size: 12px; border-top: 1px dashed #cbd5e1; display: inline-block; padding-top: 4px; color: #64748b;\">Authorized Receiver</p>\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n</div>",
